<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A dark, flat theme with no action bar: the app draws its own header. -->
    <style name="NexoraTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/nxl_splash</item>
        <item name="android:statusBarColor">@color/nxl_surface</item>
        <item name="android:navigationBarColor">@color/nxl_surface</item>
        <item name="android:colorAccent">@color/nxl_primary</item>
    </style>
</resources>
