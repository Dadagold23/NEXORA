// The about screen, written in NXL.

print("# About");
print("");
print("This app is the " + app_name + " mobile starter.");
print("");
print("# What is really NXL here");
print("");
print("- The compiler: one implementation, used by the desktop tool and this app.");
print("- The interpreter: it compiles and runs each program as you open it.");
print("- This text: assembled by string concatenation and a loop, not by a layout engine.");
print("");
print("# What is Android");
print("");
print("- The activity, the views, and the taps.");
print("- Deciding which program to run for a tab.");
print("");
print("Splitting it that way is deliberate. The drawing is the platform's job; the words are the language's.");
print("");
print(app_name + " " + app_version + ", running in-process.");
