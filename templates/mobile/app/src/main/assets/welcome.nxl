// The welcome screen, written in NXL.
//
// This file is not decoration: MainActivity hands this exact text (prefixed by
// the generated mobile.nxl bindings) to the NXL engine, and the engine compiles
// and runs it on the device. The lines it prints are what appears on screen.
//
// Each printed line starts with a marker the activity understands:
//
//   #   a heading
//   -   a bullet
//   anything else  body text
//
// A blank line is a paragraph break.

let features = ["Compiler", "Virtual machine", "Language server", "Templates", "Database"];

print("# " + welcome_heading);
print("");
print(welcome_body);
print("");
print("# The engine that drew it");
for feature in features {
    print("- " + feature);
}
print("");
print("# Try the navigation");
for screen in screen_labels {
    print("- " + screen);
}
print("");
print("Nothing here was drawn by hand. Change nxl.toml or this file, rebuild, and the screen changes.");
