// PROJECT_NAME - application entry point.
//
// Run it with the development server:
//
//     nexora dev
//
// The program prints a boot log. public/bootstrap.js captures everything the
// program prints, fills the landing page in from it, and clears the splash
// screen when it sees the READY line at the end.

from app.config import app_name;
from app.config import tagline;
from app.config import features;
from app.state import AppState;
from app.routes import routes;

fn main() {
    print("booting " + app_name());
    print("tagline " + tagline());

    let state = AppState();

    state.advance("modules");
    for route in routes() {
        print("route  " + route);
    }

    state.advance("features");
    for feature in features() {
        print("feature  " + feature);
    }

    state.advance("ready");
    print("state " + state.describe());

    // The splash screen is cleared when this line arrives. Removing it leaves
    // the page on its loading state, which is the honest failure mode.
    print("READY");
}