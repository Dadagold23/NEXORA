// Application metadata.
//
// The landing page is static markup, but everything it says about the app is
// printed from here at boot, so the copy lives in one place instead of being
// duplicated between the page and the program.

fn app_name() -> String {
    return "PROJECT_NAME";
}

fn tagline() -> String {
    return "Running on the NXL development server.";
}

fn features() -> [String] {
    return [
        "Compiled to JavaScript and served with live reload",
        "A splash screen that clears when the app reports ready",
        "Modules, classes and arrays from the language itself"
    ];
}