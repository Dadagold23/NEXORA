{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NXL",
  "scopeName": "source.nxl",
  "fileTypes": ["nxl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.nxl", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nxl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.nxl", "match": "\\\\." },
            {
              "name": "meta.embedded.expression.nxl",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            },
            { "name": "variable.other.interpolated.nxl", "match": "\\$[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.nxl", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.nxl", "match": "\\b\\d+\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.nxl" },
            "2": { "name": "entity.name.function.nxl" }
          }
        },
        {
          "match": "\\b(struct|class|enum|interface|trait|actor|module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.nxl" },
            "2": { "name": "entity.name.type.nxl" }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+for\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.impl.nxl" },
            "2": { "name": "entity.name.type.nxl" },
            "3": { "name": "entity.name.type.nxl" }
          }
        },
        {
          "match": "\\b(let|const)\\s+(mut\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.nxl" },
            "2": { "name": "storage.modifier.nxl" },
            "3": { "name": "variable.other.definition.nxl" }
          }
        },
        {
          "match": "\\b(from|import|use)\\s+([A-Za-z_][A-Za-z0-9_:]*)\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.nxl" },
            "2": { "name": "entity.name.namespace.nxl" },
            "3": { "name": "keyword.control.as.nxl" },
            "4": { "name": "variable.other.alias.nxl" }
          }
        },
        { "name": "keyword.control.import.nxl", "match": "\\b(from|import|use|module|export)\\b" },
        { "name": "keyword.control.as.nxl", "match": "\\bas\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.nxl", "match": "\\b(if|else|match|when|case|for|while|loop|break|continue|return|yield|do|in|is|not|and|or)\\b" },
        { "name": "keyword.control.exception.nxl", "match": "\\b(try|catch|finally|throw)\\b" },
        { "name": "keyword.other.async.nxl", "match": "\\b(async|await|spawn|channel)\\b" },
        { "name": "storage.modifier.nxl", "match": "\\b(mut|ref|borrow|unsafe|pub)\\b" },
        { "name": "constant.language.nxl", "match": "\\b(true|false|null)\\b" },
        { "name": "keyword.other.new.nxl", "match": "\\bnew\\b" },
        { "name": "keyword.other.type.nxl", "match": "\\b(type|where|self)\\b" },
        { "name": "support.function.builtin.nxl", "match": "\\b(print|assert|test)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nxl",
          "match": "\\b(Int|Float|Bool|String|Array|Unit|Object|Channel|Task)\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.nxl" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.nxl", "match": "(\\+\\+|--|==|!=|<=|>=|&&|\\|\\||->|=>|\\+=|-=|\\*=|/=)" },
        { "name": "keyword.operator.arithmetic.nxl", "match": "[-+*/%]" },
        { "name": "keyword.operator.comparison.nxl", "match": "<|>" },
        { "name": "keyword.operator.assignment.nxl", "match": "[=!]" },
        { "name": "keyword.operator.logical.nxl", "match": "[&|]" },
        { "name": "punctuation.separator.nxl", "match": "[,;:]" },
        { "name": "punctuation.accessor.nxl", "match": "\\.|#" }
      ]
    }
  }
}